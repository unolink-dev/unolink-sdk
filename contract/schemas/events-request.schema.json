{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unolink.dev/schemas/v1/events-request.json",
  "title": "POST /v1/events request",
  "type": "object",
  "required": ["installId", "events"],
  "properties": {
    "installId": { "type": "string", "format": "uuid" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "name", "timestamp"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,63}$" },
          "timestamp": { "type": "string", "format": "date-time" },
          "properties": {
            "type": ["object", "null"],
            "maxProperties": 20,
            "additionalProperties": {
              "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "number" }, { "type": "boolean" }]
            }
          },
          "revenue": {
            "type": ["object", "null"],
            "required": ["amount", "currency"],
            "properties": {
              "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,6})?$" },
              "currency": { "type": "string", "pattern": "^[A-Za-z]{3}$" }
            }
          }
        },
        "if": { "properties": { "name": { "const": "purchase" } } },
        "then": { "required": ["revenue"], "properties": { "revenue": { "type": "object" } } }
      }
    }
  }
}
