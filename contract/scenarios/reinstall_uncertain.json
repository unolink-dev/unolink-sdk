{
  "name": "reinstall_uncertain",
  "description": "A second install carrying a click ID already credited to another install is uncertain, never double-counted.",
  "setup": { "plan": "pro", "key": "valid", "links": [{ "slug": "tiktok" }] },
  "steps": [
    { "click": { "link": "tiktok", "save": "c1" } },
    {
      "request": { "method": "POST", "path": "/v1/install", "body": {
        "installId": "${uuid:first}", "platform": "android", "sdk": { "name": "android", "version": "1.0.0" },
        "playReferrer": { "raw": "${referrer:c1}" } } },
      "expect": { "status": 200, "body": { "attribution": { "status": "attributed" } } }
    },
    {
      "request": { "method": "POST", "path": "/v1/install", "body": {
        "installId": "${uuid:second}", "platform": "android", "sdk": { "name": "android", "version": "1.0.0" },
        "playReferrer": { "raw": "${referrer:c1}" } } },
      "expect": { "status": 200, "body": { "attribution": { "status": "uncertain", "source": "play_referrer" } } }
    }
  ]
}
